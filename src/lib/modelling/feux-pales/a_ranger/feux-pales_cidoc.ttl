    rdfs:label "historienne de l'art"@fr .

ex:role7 a crm:E55_Type ;
    rdfs:label "agence artistique fictionnelle"@fr .

ex:role8 a crm:E55_Type ;
    rdfs:label "sérigraphe"@fr .

ex:role9 a crm:E55_Type ;
    rdfs:label "archiviste"@fr .

ex:role10 a crm:E55_Type ;
    rdfs:label "ayant-droit"@fr .

# --- Langues ---
ex:lgfr a crm:E56_Language ;
    rdfs:label "français" .

