    crm:P4_has_time-span exhib:timespan003 .

exhib:exhib04 a crm:E7_Activity ;
    rdfs:label "Cabinet d'amateur" ;
    crm:P2_has_type exhib:type_adaptation ;
    crm:P2_has_type exhib:type_documentation ;
    crm:P136_was_based_on exhib:feuxPales ;
    crm:P16_used_specific_object exhib:accrochage_cabinet_amateur ;
    crm:P4_has_time-span exhib:timespan004 .

