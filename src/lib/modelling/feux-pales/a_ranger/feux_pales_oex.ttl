ex:HansHaacke a crm:E21_Person ; rdfs:label "Hans Haacke"@fr ;
    oex:isCreatorOf ex:GuggenheimBoard .


#############################################################################
# 12. PRÊTEURS / PROPRIÉTAIRES INSTITUTIONNELS (échantillon)
#############################################################################

ex:ArturoSchwarzCollection a oex:Collector ;
    rdfs:label "Collection Arturo Schwarz, Milan"@fr ;
    oex:isOwnerOf ex:Fontaine1917 .

ex:ReneBlockCollection a oex:Collector ;
    rdfs:label "Collection René Block, Berlin"@fr ;
    oex:isLenderOf ex:DeuxCostumesFeutre .

ex:StedelijkMuseum a oex:Museum ;
    rdfs:label "Stedelijk Museum, Amsterdam"@fr ;
