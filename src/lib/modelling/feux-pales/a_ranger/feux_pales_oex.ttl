ex:KunsthistorischesMuseum a oex:Museum ;
    rdfs:label "Kunsthistorisches Museum, Vienne"@fr ;
    oex:isOwnerOf ex:KlappaltarchenAutel .


#############################################################################
# 13. ÉLÉMENTS MUSÉOGRAPHIQUES (échantillon — Non_Produced_Material_Object)
#############################################################################

ex:CimaisesExposition a oex:Non_Produced_Material_Object ;
    rdfs:label "Cimaises"@fr ;
    oex:description "Bois couvert de tissu, peint en blanc ; n'avaient pas été construites pour l'occasion."@fr ;
    oex:isDisplayedAt ex:FeuxPales .

ex:ChaisesSurveillants a oex:Non_Produced_Material_Object ;
    rdfs:label "Chaises pour surveillants de salles"@fr ;
    oex:description "Attribuées à Robert Mallet-Stevens, version en laque époxy gris anthracite."@fr ;
    rdfs:comment "Attribution à vérifier — donnée incertaine au sens du code couleur du Tome II (PRISM : déclarer l'incertitude comme donnée positive plutôt que l'omettre)."@fr ;
    oex:isDisplayedAt ex:FeuxPales .
