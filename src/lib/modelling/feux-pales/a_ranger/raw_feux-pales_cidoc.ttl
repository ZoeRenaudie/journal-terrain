# -------------------------------------------------------------------
# Distinguer les objets exposés des objets sourcés
# -------------------------------------------------------------------

# @done5 : ajouter curatorial holding. @todo et pouvoir déclarer l'inspiration de feux pales sur l'ombre du jaseur peut etre de l'accrochage ? 

exhib:accrochage_feuxPales a crm:E78_Curated_Holding ;
    rdfs:label "Accrochage de l'exposition *Feux Pâles* (CAPC, 1990-1991)" ;
    crm:P4_has_time-span exhib:timespan001 ;  # Même time-span que l'exposition
    crm:P7_took_place_at exhib:place001 ;      # Même lieu que l'exposition
    crm:P14_carried_out_by exhib:agent001 ;   # Commissaire : Philippe Thomas
    crm:P14.1_in_the_role_of exhib:role1 ;     # Rôle : commissaire
    crm:P53_has_former_or_current_owner exhib:capc ;  # Propriétaire : CAPC
    crm:P3_has_note "À compléter avec le contenu de feux-pales_display."@fr .

# --- Composition du Curated Holding ---
exhib:accrochage_feuxPales crm:P46_is_composed_of exhib:exhibit0001 ;
                          crm:P46_is_composed_of exhib:exhibit0002 .

exhib:accrochage_feuxPales crm:P46_is_composed_of exhib:trace0001 . # pour dire que l'accrochage fait partie de l'exposition. 

# --- Plusieurs versions de l'accrochage ---
# Version 1 de l'accrochage (début de l'exposition)
exhib:accrochage_v1 a crm:E78_Curated_Holding ;
    crm:P46_is_composed_of exhib:exhibit0001 ;
    crm:P4_has_time-span exhib:timespan_v1 .

# Version 2 de l'accrochage (après modification)
exhib:accrochage_v2 a crm:E78_Curated_Holding ;
    crm:P46_is_composed_of exhib:exhibit0001 ;
    crm:P46_is_composed_of exhib:exhibit0003 ;  # Nouvelle œuvre ajoutée
    crm:P4_has_time-span exhib:timespan_v2 .

# L'événement utilise les deux versions
exhib:exhib01 crm:P16_used_specific_object exhib:accrochage_v1 ;
            crm:P16_used_specific_object exhib:accrochage_v2 .

# Les expôts peuvent etre dans les deux accrochages. 
# @todo : # --- Curation FP ---
exhib:curation_feuxpales rdf:type crm:E87_Curation_Activity ;
    crm:P14_carried_out_by exhib:jlf_froment ;
    crm:P147_curated exhib:capc ;
    crm:P4_has_time-span exhib:timespan_feuxpales ;
    crm:P3_has_note "Activité de commissariat et d'organisation de l'exposition Feux pâles. Inclut la gestion des prêts et la scénographie."@fr .


