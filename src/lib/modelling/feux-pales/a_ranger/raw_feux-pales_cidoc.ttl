    rdfs:label "Ancien catalogue" ;
    crm:P2_has_type exhib:type_perime ;
    exhib:has_certainty_degree 0.0 ;  # 0% de certitude
    crm:P3_has_note "Catalogue obsolète (degré de certitude = 0)."@fr .

