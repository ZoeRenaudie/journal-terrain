# -------------------------------------------------------------------
# Fictionnalisme
# -------------------------------------------------------------------

# Inspiration sur le fictionnalisme. 
# Feu pale de Nabokov est un livre.  
# Le livre a inspiré l'artiste dans son fictionalisme, et pour le choix du titre. C'est une clef pour résoudre l'enigme
# E73 est tres interessant par ce que c'est une entité qui peut vivre sur differents supports. 
# Et ce n'est pas le support livre qui nous interesse mais bien le recit. Est d'ailleurs subclass de Lrmoo manifestation et Expression

# --- Œuvre littéraire : "Feux pâles" de Nabokov ---
exhib:nabokov_feu_pale a crm:E73_Information_Object ;
    rdfs:label "Feu pâle (Nabokov)" ;
    crm:P1_is_identified_by exhib:nabokov_feu_pale_id ;
    crm:P3_has_note "Roman de Vladimir Nabokov (1962), source d'inspiration pour Philippe Thomas (fictionnalisme et titre)."@fr ;
    crm:P129_is_about exhib:fictionnalisme ; # utiliser is about pour relier au fictionnalisme. : ou P130_shows_features_of ? @done10 : ajouter une sorte de clef d'enquete
    crm:P1_is_identified_by exhib:nabokov_feu_pale_appellation .  

# --- Appellation (titre du livre) ---
exhib:nabokov_feu_pale_appellation a crm:E41_Appellation ;
    rdf:value "Feu pâle"@fr ;
    crm:P3_has_note "Titre français du roman de Vladimir Nabokov (1962)."@fr .

# --- Lien d'inspiration avec *Feux Pâles* de Philippe Thomas ---
exhib:feuxPales crm:P15_was_influenced_by exhib:nabokov_feu_pale ;
                crm:P3_has_note "Inspiration du titre et du concept de fictionnalisme."@fr .

# --- Concept de "fictionnalisme" ---
exhib:fictionnalisme a crm:E28_Conceptual_Object ;
    rdfs:label "Fictionnalisme"@fr ;
    crm:P1_is_identified_by exhib:fictionnalisme_id .

exhib:fictionnalisme_id a crm:E41_Appellation ;
    rdf:value "Fictionnalisme"@fr .
    #@todo : lien avec la these de Jaret et d'autres livres. Donner une definition
# @todo comment déclarer la clef de l'enquête, Jaret considere que ce n'est pas partie de son fictionnalisme. 

