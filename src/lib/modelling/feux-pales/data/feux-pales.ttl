@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix ex: <http://example.org/feux-pales/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:exposition_feux_pales a crm:E5_Event ;
    rdfs:label "Feux pâles" ;
    crm:P4_has_time-span ex:periode_1990_91 ;
    crm:P7_took_place_at ex:capc_bordeaux ;
    crm:P14_carried_out_by ex:agence_readymades .

ex:periode_1990_91 a crm:E52_Time-Span ;
    rdfs:label "1990-1991" .

ex:capc_bordeaux a crm:E53_Place ;
    rdfs:label "capcMusée de Bordeaux" .

ex:agence_readymades a crm:E39_Actor ;
    rdfs:label "© readymades appartiennent à tout le monde®" ;
    crm:P14i_performed ex:exposition_feux_pales .

ex:philippe_thomas a crm:E21_Person ;
    rdfs:label "Philippe Thomas" ;
    crm:P14_carried_out_by ex:agence_readymades .

ex:oeuvre_exposee a crm:E22_Human-Made_Object ;
    rdfs:label "Œuvre exposée" ;
    crm:P12i_was_present_at ex:exposition_feux_pales .