########################################################
########################################################

ex:accrochage_OmbreJaseur a la:set ;
    rdfs:label "Accrochage de l'exposition Ombre du jaseur au MAMCO" ;
    crm:P4_has_time-span ex:time_span_2014 ;  
    crm:P7_took_place_at ex:place002 ;      
    crm:P14_carried_out_by ex:agent003 ;   
    crm:P14.1_in_the_role_of ex:role_commissaire ;
    crm:P136_was_based_on ex:accrochage_feuxPales .




########################################################
# Appellations, Types et Rôles
########################################################

# appellations #########################################

ex:appellation_FeuxPales a crm:E41_Appellation ;
    rdf:value "Feux Pâles" .

# types ################################################

# Mapper les vocab aat

ex:typo_expo_temporaire a crm:E55_Type ;
    rdfs:label "exposition temporaire"@fr . 

ex:type_adaptation a crm:E55_Type ;
    rdfs:label "adaptation de l'exposition"@fr .

# --- Types d'objets ---
ex:type_oeuvre a crm:E55_Type ;
    rdfs:label "œuvre d'art"@fr .

ex:type_archives a crm:E55_Type ;
    rdfs:label "archive"@fr .

ex:capc_type a crm:E55_Type ;
    rdfs:label "Musée"@fr .

ex:type_non_reproductible a crm:E55_Type ;
    rdfs:label "Non-reproducible work" .

# --- classifications ---

ex:type_reconstitution_rigoureuse a crm:E55_Type ;
    rdfs:label "Reconstitution exige un accompagnement documentaire rigoureux" .

ex:type_pas_de_statut a crm:E55_Type ;
    rdfs:label "Pas de statut particulier dans la programmation de l'ère Froment" .

ex:type_interpretation_libre a crm:E55_Type ;
    rdfs:label "Interprétation libre, non une reconstitution" .

ex:type_positions_valables a crm:E55_Type ;
    rdfs:label "Toutes les positions sont valables" .

ex:type_expo_oeuvre a crm:E55_Type ;
  rdfs:label "Feux pâles est une oeuvre" .

ex:type_expo_nonoeuvre a crm:E55_Type ;
  rdfs:label "Feux pâles n'est pas une oeuvre, c'est une exposition" .

# rôles ################################################

ex:role_archiviste a crm:E55_Type ;
    rdfs:label "archiviste"@fr . # aat

ex:role_commissaire a crm:E55_Type ;
    rdfs:label "commissaire d'exposition"@fr .

ex:role_artiste a crm:E55_Type ;
    rdfs:label "artiste" .

ex:role_directeur a crm:E55_Type ;
    rdfs:label "directeur de musée"@fr .

ex:role_galeriste a crm:E55_Type ;
    rdfs:label "galeriste"@fr .

ex:role_photographe a crm:E55_Type ;
    rdfs:label "photographe"@fr .

ex:role_historienne a crm:E55_Type ;
    rdfs:label "historienne de l'art"@fr .

ex:role_serigraphe a crm:E55_Type ;
    rdfs:label "sérigraphe"@fr .

ex:role_ayantdroit a crm:E55_Type ;
    rdfs:label "ayant-droit"@fr .

# Langues ##############################################
ex:lgfr a crm:E56_Language ;
    rdfs:label "français" .