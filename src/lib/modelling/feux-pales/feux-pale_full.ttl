  crm:P4_has_time_span ex:time_span_2016_2017 ;
  crm:P94_has_created ex:rapport_conservation ;
  crm:P11_had_participant ex:zoe_renaudie, ex:claire_burrus, ex:emeline_jaret, ex:martine_paen, ex:paul_bernard.

