ex:Etude_RDF_2026 a rdfs:Graph ;
  rdfs:label "Graphe CIDOC-CRM : *Feux Pâles*"@fr ;
  rdfs:comment "Modélisation Feux Pâles de Philippe Thomas, ses activations et de leurs relations avec les œuvres, acteurs et archives."@fr ;
  crm:P1_is_identified_by ex:graph_id ;
  crm:P2_has_type ex:type_graph ;
  crm:P4_has_time-span ex:graph_timespan .

ex:graph_id a crm:E42_Identifier ;
  rdf:value "feux-pales-exhibition-2026" .

ex:type_graph a crm:E55_Type ;
  rdfs:label "Graphe CIDOC-CRM"@fr .

ex:graph_timespan a crm:E52_Time-Span ;
  crm:P81a_begin_of_the_begin "2026-07-10T00:00:00"^^xsd:dateTime ;
  crm:P81b_end_of_the_end "2026-07-10T00:00:00"^^xsd:dateTime .


