  rdfs:label "Feux Pâles" ;
  crm:P1_is_identified_by ex:appellation_FeuxPales ;
  crm:P3_has_note "Œuvre conceptuelle de Philippe Thomas, existant tant qu'elle est mémorisée ou documentée."@fr .


# --- Exposition 1 : Feux Pâles (CAPC, 1990-1991) ---
ex:feux_pales_expo a crm:E7_Activity ;
  rdfs:label "Exposition Feux pâles"@fr ;
  crm:P1_is_identified_by ex:appellation_FeuxPales ;
  crm:P17_was_motivated_by ex:commande_feux_pales ;
  crm:P2_has_type aat:300417758 ;  # aat : art exhibition
  crm:P2_has_type ex:typo_expo_temporaire ;
  crm:P1_is_identified_by ex:appellation_FeuxPales ;
  crm:P14_carried_out_by ex:philippe_thomas ;
  crm:P14.1_in_the_role_of ex:role_commissaire ;  # Rôle : commissaire d'exposition
  crm:P7_took_place_at ex:place001 ;
  crm:P4_has_time-span ex:time_span_1990_1991 ;
  crm:P129_is_about ex:feux_pales_concept ;  # L'exposition traite du concept "Feux Pâles"
  crm:P16_used_specific_object ex:accrochage_feuxPales ;
  crm:P12_occurred_in_the_presence_of ex:philippe_thomas, ex:claire_burrus, ex:jean_louis_froment, ex:martine_paen .

# --- Exposition 2 : L'Ombre du jaseur (2014)---
ex:ombreJaseur_expo a crm:E7_Activity ;
  rdfs:label "L'Ombre du jaseur (d'après Feux Pâles)" ;
  crm:P2_has_type ex:type_adaptation ;  # Type : adaptation
  crm:P136_was_based_on ex:feux_pales_concept ;  # Basée sur le concept "Feux Pâles"
  crm:P16_used_specific_object ex:archive_capc ; 
  crm:P16_used_specific_object ex:accrochage_OmbreJaseur ;
  crm:P3_has_note "Philippe Thomas n'a pas participé à cette itération."@fr ;
  crm:P12_occurred_in_the_presence_of ex:claire_burrus, ex:paul_bernard, ex:martine_paen, ex:emeline_jaret .

# --- Un Cabinet d'amateur ---
ex:cabinet_amateur a crm:E7_Activity ;
  rdfs:label "Cabinet d'amateur" ;
  crm:P2_has_type ex:type_adaptation ;  
  crm:P2_has_type ex:type_documentation ; 
  crm:P136_was_based_on ex:feux_pales_concept ; 
