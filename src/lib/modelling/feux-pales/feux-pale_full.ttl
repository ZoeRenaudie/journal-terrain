  crm:P14_carried_out_by ex:jean_louis_froment ;
  crm:P14_carried_out_by ex:agence_rmatlm ; 
  crm:P4_has_time-span "1990" ;
  dcterms:source ex:rapport_conservation ;
  crm:P3_has_note "Commande de Jean-Louis Froment à l'agence rmatlm pour l'exposition" .

ex:feux_pales_expo crm:P16_used_specific_object ex:ensemble_cartels_feux_pales ;
  crm:P16_used_specific_object ex:collection_feux_pales_96_objets .

########################################################
# Scéno
########################################################

ex:conception_cartels_feux_pales a crm:E7_Activity ;
  rdfs:label "Conception des cartels de l'exposition Feux pâles" ;
  crm:P14_carried_out_by ex:philippe_thomas ;
  crm:P4_has_time-span "1990" ; 
  dcterms:source ex:rapport_conservation ;
  crm:P3_has_note "Cartels simples conçus par Philippe Thomas" .

ex:ensemble_cartels_feux_pales a crm:E22_Man-Made_Object ;
  rdfs:label "Ensemble des cartels de Feux pâles" ;
  crm:P108_was_produced_by ex:conception_cartels_feux_pales .

ex:collection_feux_pales_96_objets a crm:E27_Site ; # Ou E78_Collection si défini dans votre extension
  rdfs:label "Collection des 96 biens de Feux pâles" ;
  crm:P3_has_note "96 biens culturels, 82 artistes/auteurs/artisans (dont 5 fictifs, 40 anonymes), dates identifiées de 1520 à 1990" .

